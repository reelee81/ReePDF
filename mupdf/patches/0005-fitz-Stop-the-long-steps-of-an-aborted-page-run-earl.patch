diff --git a/source/fitz/context.c b/source/fitz/context.c
index 9549b55..5f8bba1 100644
--- a/source/fitz/context.c
+++ b/source/fitz/context.c
@@ -323,6 +323,9 @@ fz_clone_context(fz_context *ctx)
 	/* Reset error context to initial state. */
 	fz_init_error_context(new_ctx);
 
+	/* A clone does not take part in the page run of its parent. */
+	new_ctx->abort_flag = NULL;
+
 	/* Then keep lock checking happy by keeping shared contexts with new context */
 	fz_keep_document_handler_context(new_ctx);
 	fz_keep_archive_handler_context(new_ctx);
@@ -380,3 +383,36 @@ int fz_new_document_id(fz_context *ctx)
 
 	return id;
 }
+
+#if defined(__GNUC__) || defined(__clang__)
+static __thread int *thread_abort_flag;
+#define HAVE_THREAD_ABORT_FLAG
+#endif
+
+int *
+fz_set_abort_flag(fz_context *ctx, int *flag)
+{
+	int *previous = ctx->abort_flag;
+	ctx->abort_flag = flag;
+#ifdef HAVE_THREAD_ABORT_FLAG
+	thread_abort_flag = flag;
+#endif
+	return previous;
+}
+
+int
+fz_thread_abort_requested(void)
+{
+#ifdef HAVE_THREAD_ABORT_FLAG
+	return thread_abort_flag && *(volatile int *)thread_abort_flag;
+#else
+	return 0;
+#endif
+}
+
+void
+fz_check_abort(fz_context *ctx)
+{
+	if (fz_abort_requested(ctx))
+		fz_throw(ctx, FZ_ERROR_ABORT, "aborted");
+}
