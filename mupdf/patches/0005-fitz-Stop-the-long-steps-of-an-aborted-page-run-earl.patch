diff --git a/include/mupdf/fitz/context.h b/include/mupdf/fitz/context.h
index e2553b7..6f3217a 100644
--- a/include/mupdf/fitz/context.h
+++ b/include/mupdf/fitz/context.h
@@ -909,6 +909,7 @@ struct fz_context
 	/* unshared contexts */
 	fz_aa_context aa;
 	fz_chacha20 seed;
+	int *abort_flag;
 #if FZ_ENABLE_ICC
 	int icc_enabled;
 #endif
@@ -930,6 +931,33 @@ struct fz_context
 
 fz_context *fz_new_context_imp(const fz_alloc_context *alloc, const fz_locks_context *locks, size_t max_store, const char *version);
 
+/**
+	Abort support for long steps inside a page run.
+
+	While a page is run with a cookie, ctx->abort_flag points to
+	cookie->abort, so long loops deep inside the run (image
+	decoding, scaling, painting, rasterizing) can stop early once
+	the cookie is aborted. Code whose result may be stored throws
+	FZ_ERROR_ABORT (fz_check_abort); code that only draws into the
+	page being aborted may simply stop (fz_abort_requested).
+
+	fz_set_abort_flag returns the previous flag, so that a run can
+	restore it when it ends. It also records the flag for the calling
+	thread, so that code that gets no context (painting helpers, the
+	lcms2 abort check) can ask fz_thread_abort_requested.
+*/
+static inline int
+fz_abort_requested(fz_context *ctx)
+{
+	return ctx->abort_flag && *(volatile int *)ctx->abort_flag;
+}
+
+int *fz_set_abort_flag(fz_context *ctx, int *flag);
+
+void fz_check_abort(fz_context *ctx);
+
+int fz_thread_abort_requested(void);
+
 /**
 	Lock one of the user supplied mutexes.
 */
