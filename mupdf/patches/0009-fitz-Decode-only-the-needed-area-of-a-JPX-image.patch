+static void
+block_starts(int *out, int k0, int k1, int size, int f)
+{
+	int sub = size % f ? f - size % f : 0;
+	int d = (size + sub) / f - 1;
+	int e = d - ((d + 1) >> 1);
+	int s = 0;
+	int k;
+
+	for (k = 0; k < k1; k++)
+	{
+		if (k >= k0)
+			out[k - k0] = s;
+		s += f;
+		e -= sub;
+		while (e < 0)
+		{
+			s--;
+			e += d;
+		}
+	}
+}
+
+static void
+subsample_jpx_window(fz_context *ctx, fz_pixmap *tile, int factor, const fz_irect *rect, int w, int h, int reduce)
+{
+	int f = 1 << factor;
+	int l2 = reduce + factor;
+	int wr = (w + (1 << reduce) - 1) >> reduce;
+	int hr = (h + (1 << reduce) - 1) >> reduce;
+	int kx0 = rect->x0 >> l2;
+	int ky0 = rect->y0 >> l2;
+	int ow = ((rect->x1 + (1 << l2) - 1) >> l2) - kx0;
+	int oh = ((rect->y1 + (1 << l2) - 1) >> l2) - ky0;
+	int n = tile->n;
+	int *sx = NULL;
+	int *sy = NULL;
+	unsigned char *out = NULL;
+	int covered = 1;
+	int i, j, c, xx, yy;
+
+	if (!((wr % f || hr % f) && wr >= f && hr >= f))
+	{
+		fz_subsample_pixblock(tile->samples, tile->w, tile->h, n, factor, tile->stride);
+		tile->w = (tile->w + f - 1) >> factor;
+		tile->h = (tile->h + f - 1) >> factor;
+		tile->stride = tile->w * (size_t)n;
+		tile->samples = fz_realloc(ctx, tile->samples, (size_t)tile->h * tile->w * n);
+		return;
+	}
+
+	fz_var(sx);
+	fz_var(sy);
+	fz_var(out);
+	fz_try(ctx)
+	{
+		sx = fz_malloc_array(ctx, ow, int);
+		sy = fz_malloc_array(ctx, oh, int);
+		block_starts(sx, kx0, kx0 + ow, wr, f);
+		block_starts(sy, ky0, ky0 + oh, hr, f);
+		for (i = 0; i < ow; i++)
+		{
+			sx[i] -= tile->x;
+			if (sx[i] < 0 || sx[i] + f > tile->w)
+				covered = 0;
+		}
+		for (j = 0; j < oh; j++)
+		{
+			sy[j] -= tile->y;
+			if (sy[j] < 0 || sy[j] + f > tile->h)
+				covered = 0;
+		}
+		if (covered)
+		{
+			out = fz_malloc(ctx, (size_t)ow * oh * n);
+			for (j = 0; j < oh; j++)
+				for (i = 0; i < ow; i++)
+					for (c = 0; c < n; c++)
+					{
+						int v = 0;
+						for (yy = 0; yy < f; yy++)
+						{
+							const unsigned char *src = tile->samples + (size_t)(sy[j] + yy) * tile->stride + (size_t)sx[i] * n + c;
+							for (xx = 0; xx < f; xx++)
+								v += src[(size_t)xx * n];
+						}
+						out[((size_t)j * ow + i) * n + c] = v >> (2 * factor);
+					}
+		}
+	}
+	fz_always(ctx)
+	{
+		fz_free(ctx, sx);
+		fz_free(ctx, sy);
+	}
+	fz_catch(ctx)
+	{
+		fz_free(ctx, out);
+		fz_rethrow(ctx);
+	}
+	if (!out)
+	{
+		fz_subsample_pixmap(ctx, tile, factor);
+		return;
+	}
+	fz_free(ctx, tile->samples);
+	tile->samples = out;
+	tile->w = ow;
+	tile->h = oh;
+	tile->stride = ow * (size_t)n;
+}
