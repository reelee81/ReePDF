+static void
+update_ctm_for_jpx_window(fz_matrix *ctm, const fz_irect *rect, int w, int h, int l2factor)
+{
+	int f = 1 << l2factor;
+	int fw = (w + f - 1) >> l2factor;
+	int fh = (h + f - 1) >> l2factor;
+	int x0 = rect->x0 >> l2factor;
+	int y0 = rect->y0 >> l2factor;
+	int x1 = (rect->x1 + f - 1) >> l2factor;
+	int y1 = (rect->y1 + f - 1) >> l2factor;
+	fz_matrix m;
+
+	m.a = (float) (x1 - x0) / fw;
+	m.b = 0;
+	m.c = 0;
+	m.d = (float) (y1 - y0) / fh;
+	m.e = (float) x0 / fw;
+	m.f = (float) y0 / fh;
+	*ctm = fz_concat(m, *ctm);
+}
