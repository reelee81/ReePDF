+static int
+is_jpx_window(fz_context *ctx, fz_image *image, const fz_irect *rect)
+{
+	return is_jpx_image(ctx, image) && (rect->x0 > 0 || rect->y0 > 0 || rect->x1 < image->w || rect->y1 < image->h);
