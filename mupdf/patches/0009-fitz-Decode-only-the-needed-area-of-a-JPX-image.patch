+static int64_t
+jpx_lcm(int64_t a, int64_t b)
+{
+	int64_t x = a, y = b;
+	while (y)
+	{
+		int64_t t = x % y;
+		x = y;
+		y = t;
+	}
+	return a / x * b;
+}
+
+static int
+jpx_set_area(opj_codec_t *codec, opj_image_t *jpx, int reduce, int l2factor, fz_irect *area, int *ox, int *oy)
+{
+	int64_t f = (int64_t)1 << l2factor;
+	int64_t ax = (int64_t)1 << reduce;
+	int64_t ay = ax;
+	int64_t ix0 = jpx->x0, iy0 = jpx->y0, ix1 = jpx->x1, iy1 = jpx->y1;
+	int64_t x0, y0, x1, y1, dx0, dy0;
+	OPJ_UINT32 k;
+
+	if (ix0 % f != 0 || iy0 % f != 0)
+		return 0;
+	for (k = 0; k < jpx->numcomps; k++)
+	{
+		ax = jpx_lcm(ax, (int64_t)jpx->comps[k].dx << reduce);
+		ay = jpx_lcm(ay, (int64_t)jpx->comps[k].dy << reduce);
+		if (ax > 4096 || ay > 4096)
+			return 0;
