+static int
+jp2_find_box(const unsigned char *data, size_t size, const char *type, const unsigned char **body, size_t *body_size)
+{
+	size_t pos = 0;
+
+	while (size - pos >= 8)
+	{
+		uint64_t len = ((uint64_t)data[pos] << 24) | ((uint64_t)data[pos + 1] << 16) | ((uint64_t)data[pos + 2] << 8) | data[pos + 3];
+		size_t hdr = 8;
+		int i;
+
+		if (len == 1)
+		{
+			if (size - pos < 16)
+				return -1;
+			len = 0;
+			for (i = 0; i < 8; i++)
+				len = (len << 8) | data[pos + 8 + i];
+			hdr = 16;
+		}
+		else if (len == 0)
+			len = size - pos;
+		if (len < hdr || len > size - pos)
+			return -1;
+		if (!memcmp(data + pos + 4, type, 4))
+		{
+			*body = data + pos + hdr;
+			*body_size = (size_t)len - hdr;
+			return 1;
+		}
+		pos += (size_t)len;
+	}
+	return 0;
+}
+
+static int
+jp2_may_have_palette(const unsigned char *data, size_t size)
+{
+	const unsigned char *header, *palette;
+	size_t header_size, palette_size;
+
+	if (jp2_find_box(data, size, "jp2h", &header, &header_size) != 1)
+		return 1;
+	return jp2_find_box(header, header_size, "pclr", &palette, &palette_size) != 0;
+}
+
+static int
+jpx_set_reduction(fz_context *ctx, opj_codec_t *codec, OPJ_CODEC_FORMAT format, const unsigned char *data, size_t size, fz_colorspace *defcs, int reduce)
+{
+	opj_codestream_info_v2_t *info;
+	int levels = -1;
+	OPJ_UINT32 k;
+
+	if (reduce <= 0 || fz_colorspace_is_indexed(ctx, defcs))
+		return 0;
+	if (format == OPJ_CODEC_JP2 && jp2_may_have_palette(data, size))
+		return 0;
+
+	info = opj_get_cstr_info(codec);
+	if (!info)
+		return 0;
+	if (info->m_default_tile_info.tccp_info)
+	{
+		for (k = 0; k < info->nbcomps; k++)
+		{
+			int n = (int)info->m_default_tile_info.tccp_info[k].numresolutions - 1;
+			if (levels < 0 || n < levels)
+				levels = n;
+		}
+	}
+	opj_destroy_cstr_info(&info);
+
+	reduce = fz_mini(reduce, levels);
+	if (reduce <= 0)
+		return 0;
+	if (!opj_set_decoded_resolution_factor(codec, (OPJ_UINT32)reduce))
+	{
+		opj_set_decoded_resolution_factor(codec, 0);
+		return 0;
+	}
+	return reduce;
+}
+
+static OPJ_UINT32
+jpx_reduce_coord(OPJ_UINT32 v, int reduce)
+{
+	return (OPJ_UINT32)(((uint64_t)v + (((uint64_t)1 << reduce) - 1)) >> reduce);
+}
