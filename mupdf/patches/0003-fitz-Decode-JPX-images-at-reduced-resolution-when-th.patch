+		for (k = 0; k < (int)jpx->numcomps; k++)
+		{
+			jpx->comps[k].x0 = jpx_reduce_coord(jpx->comps[k].x0, *applied);
+			jpx->comps[k].y0 = jpx_reduce_coord(jpx->comps[k].y0, *applied);
+		}
+	}
+
 	numcomps = (int)jpx->numcomps;
 
 	/* Count number of alpha and color channels */
@@ -646,11 +750,12 @@ fz_load_jpx(fz_context *ctx, const unsigned char *data, size_t size, fz_colorspa
 {
