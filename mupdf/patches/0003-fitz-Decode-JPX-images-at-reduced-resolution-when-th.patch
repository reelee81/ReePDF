@@ -485,6 +576,19 @@ jpx_read_image(fz_context *ctx, fz_jpxd *state, const unsigned char *data, size_
 	if (!jpx)
 		fz_throw(ctx, FZ_ERROR_LIBRARY, "opj_decode failed");
 
+	if (*applied > 0)
