-		pix = jpx_read_image(ctx, &state, data, size, defcs, 0);
+		pix = jpx_read_image(ctx, &state, data, size, defcs, 0, 0, &applied);
 	}
 	fz_always(ctx)
 		fz_opj_unlock(ctx);
@@ -660,15 +765,44 @@ fz_load_jpx(fz_context *ctx, const unsigned char *data, size_t size, fz_colorspa
 	return pix;
 }
 
+fz_pixmap *
+fz_load_jpx_reduced(fz_context *ctx, const unsigned char *data, size_t size, fz_colorspace *defcs, int reduce, int *applied)
+{
+	fz_jpxd state = { 0 };
+	fz_pixmap *pix = NULL;
+
+	*applied = 0;
+	fz_try(ctx)
+	{
+		fz_opj_lock(ctx);
+		pix = jpx_read_image(ctx, &state, data, size, defcs, 0, reduce, applied);
+	}
+	fz_always(ctx)
+		fz_opj_unlock(ctx);
+	fz_catch(ctx)
+	{
+		if (*applied == 0)
+			fz_rethrow(ctx);
+		fz_rethrow_if(ctx, FZ_ERROR_SYSTEM);
+		fz_report_error(ctx);
+		fz_warn(ctx, "JPX decode at reduced resolution failed; retrying at full resolution");
+		*applied = 0;
+		pix = fz_load_jpx(ctx, data, size, defcs);
+	}
+
+	return pix;
+}
