     index = 0;
     for (i = 0; i < (int) nTotalPoints; i++) {
 
+        if ((i & 1023) == 0 && _cmsAborted(ContextID))
+            return FALSE;
+
         rest = i;
         for (t = (int)nInputs - 1; t >= 0; --t) {
 
@@ -841,6 +844,9 @@ cmsBool CMSEXPORT cmsStageSampleCLutFloat(cmsContext ContextID, cmsStage* mpe, c
     index = 0;
     for (i = 0; i < (int)nTotalPoints; i++) {
 
+        if ((i & 1023) == 0 && _cmsAborted(ContextID))
+            return FALSE;
+
         rest = i;
         for (t = (int) nInputs-1; t >=0; --t) {
 
diff --git a/thirdparty/lcms2/src/lcms2_internal.h b/thirdparty/lcms2/src/lcms2_internal.h
index 9f94fe3..57616de 100644
--- a/thirdparty/lcms2/src/lcms2_internal.h
+++ b/thirdparty/lcms2/src/lcms2_internal.h
