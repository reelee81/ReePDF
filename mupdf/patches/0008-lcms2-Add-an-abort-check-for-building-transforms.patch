index c5f1be7..dcc5523 100644
--- a/thirdparty/lcms2/src/cmsgamma.c
+++ b/thirdparty/lcms2/src/cmsgamma.c
@@ -1097,6 +1097,11 @@ cmsToneCurve* CMSEXPORT cmsReverseToneCurveEx(cmsContext ContextID, cmsUInt32Num
     // Iterate across Y axis
     for (i=0; i < (int) nResultSamples; i++) {
 
+        if ((i & 63) == 0 && _cmsAborted(ContextID)) {
+            cmsFreeToneCurve(ContextID, out);
+            return NULL;
+        }
+
         y = (cmsFloat64Number) i * 65535.0 / (nResultSamples - 1);
 
         // Find interval in which y is within.
