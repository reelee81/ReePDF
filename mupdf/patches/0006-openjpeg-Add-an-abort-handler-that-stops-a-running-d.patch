+        opj_abort_callback p_callback,
+        void * p_user_data)
+{
+    opj_codec_private_t * l_codec = (opj_codec_private_t *) p_codec;
+    if (! l_codec) {
+        return OPJ_FALSE;
+    }
+
+    l_codec->m_event_mgr.abort_handler = p_callback;
+    l_codec->m_event_mgr.m_abort_data = p_user_data;
