+/**
+ * Callback asking whether a running decode should stop.
+ * It returns OPJ_TRUE to stop; the decode then fails.
+ */
+typedef OPJ_BOOL(*opj_abort_callback)(void *client_data);
+
+/**
+ * Set the abort handler used by openjpeg while decoding.
+ * The handler is asked between code-blocks and between rows of the
+ * wavelet, colour and level shift steps.
+ * @param p_codec       the codec previously initialise
+ * @param p_callback    the callback function, or NULL
+ * @param p_user_data   client object passed to the callback
+*/
+OPJ_API OPJ_BOOL OPJ_CALLCONV opj_set_abort_handler(opj_codec_t * p_codec,
+        opj_abort_callback p_callback,
+        void * p_user_data);
+
