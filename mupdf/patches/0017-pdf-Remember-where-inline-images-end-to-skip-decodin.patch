diff --git a/source/pdf/pdf-stream.c b/source/pdf/pdf-stream.c
index a33a008..bb48475 100644
--- a/source/pdf/pdf-stream.c
+++ b/source/pdf/pdf-stream.c
@@ -22,6 +22,7 @@
 
 #include "mupdf/fitz.h"
 #include "mupdf/pdf.h"
+#include "pdf-imp.h"
 
 #include <string.h>
 
@@ -426,13 +427,262 @@ pdf_open_inline_stream(fz_context *ctx, pdf_document *doc, pdf_obj *stmobj, size
 	return fz_open_null_filter(ctx, file_stm, length, fz_tell(ctx, file_stm));
 }
 
+enum
+{
+	INLINE_IMAGE_MAX_KEY = 128,
+	INLINE_IMAGE_MAX_BYTES = 4 << 20
+};
+
+typedef struct
+{
+	uint32_t offset;
+	uint32_t length;
+} pdf_inline_image_entry;
+
+typedef struct pdf_inline_image_content
+{
+	struct pdf_inline_image_content *next;
+	uint32_t hash;
+	int key_len;
+	int *key;
+	int len;
+	int cap;
+	pdf_inline_image_entry *entries;
+} pdf_inline_image_content;
+
+struct pdf_inline_image_cache
+{
+	int size;
+	int count;
+	size_t bytes;
+	pdf_inline_image_content **buckets;
+};
+
+void
+pdf_drop_inline_image_cache(fz_context *ctx, pdf_document *doc)
+{
+	struct pdf_inline_image_cache *cache = doc->inline_images;
+	int i;
+
+	if (!cache)
+		return;
+	for (i = 0; i < cache->size; i++)
+	{
+		pdf_inline_image_content *content = cache->buckets[i];
+		while (content)
+		{
+			pdf_inline_image_content *next = content->next;
+			fz_free(ctx, content->key);
+			fz_free(ctx, content->entries);
+			fz_free(ctx, content);
+			content = next;
+		}
+	}
+	fz_free(ctx, cache->buckets);
+	fz_free(ctx, cache);
+	doc->inline_images = NULL;
+}
+
+static int
+inline_image_key(fz_context *ctx, pdf_document *doc, pdf_obj *content, int *key, uint32_t *hash)
+{
+	int i, n, len;
+	uint32_t h = 2166136261u;
+
+	if (!content || doc->xref_base != 0 || doc->local_xref_nesting > 0)
+		return 0;
+	if (pdf_is_indirect(ctx, content))
+	{
+		key[0] = pdf_to_num(ctx, content);
+		key[1] = pdf_to_gen(ctx, content);
+		len = 2;
+	}
+	else if (pdf_is_array(ctx, content))
+	{
+		n = pdf_array_len(ctx, content);
+		if (n <= 0 || n * 2 > INLINE_IMAGE_MAX_KEY)
+			return 0;
+		for (i = 0; i < n; i++)
+		{
+			pdf_obj *part = pdf_array_get(ctx, content, i);
+			if (!pdf_is_indirect(ctx, part))
+				return 0;
+			key[2 * i] = pdf_to_num(ctx, part);
+			key[2 * i + 1] = pdf_to_gen(ctx, part);
+		}
+		len = 2 * n;
+	}
+	else
+		return 0;
+	for (i = 0; i < len; i++)
+		h = (h ^ (uint32_t)key[i]) * 16777619u;
+	*hash = h;
+	return len;
+}
+
+static pdf_inline_image_content *
+find_inline_image_content(struct pdf_inline_image_cache *cache, const int *key, int key_len, uint32_t hash)
+{
+	pdf_inline_image_content *content;
+
+	if (!cache)
+		return NULL;
+	for (content = cache->buckets[hash % cache->size]; content; content = content->next)
+		if (content->hash == hash && content->key_len == key_len && !memcmp(content->key, key, key_len * sizeof *key))
+			return content;
+	return NULL;
+}
+
+static int
+find_inline_image_entry(pdf_inline_image_content *content, uint32_t offset)
+{
+	int lo = 0, hi = content->len;
+
+	while (lo < hi)
+	{
+		int mid = lo + (hi - lo) / 2;
+		if (content->entries[mid].offset < offset)
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+	return lo;
+}
+
+static size_t
+pdf_find_inline_image_length(fz_context *ctx, pdf_document *doc, pdf_obj *content_obj, int64_t offset)
+{
+	int key[INLINE_IMAGE_MAX_KEY];
+	uint32_t hash;
+	int key_len, at;
+	pdf_inline_image_content *content;
+
+	if (offset < 0 || offset > UINT32_MAX)
+		return 0;
+	key_len = inline_image_key(ctx, doc, content_obj, key, &hash);
+	if (key_len == 0)
+		return 0;
+	content = find_inline_image_content(doc->inline_images, key, key_len, hash);
+	if (!content)
+		return 0;
+	at = find_inline_image_entry(content, (uint32_t)offset);
+	if (at < content->len && content->entries[at].offset == (uint32_t)offset)
+		return content->entries[at].length;
+	return 0;
+}
+
+static void
+pdf_remember_inline_image_length(fz_context *ctx, pdf_document *doc, pdf_obj *content_obj, int64_t offset, size_t length)
+{
+	int key[INLINE_IMAGE_MAX_KEY];
+	uint32_t hash;
+	int key_len, at;
+	struct pdf_inline_image_cache *cache;
+	pdf_inline_image_content *content;
+
+	if (offset < 0 || offset > UINT32_MAX || length == 0 || length > UINT32_MAX)
+		return;
+	key_len = inline_image_key(ctx, doc, content_obj, key, &hash);
+	if (key_len == 0)
+		return;
+	cache = doc->inline_images;
+	if (!cache)
+	{
+		cache = fz_malloc_struct(ctx, struct pdf_inline_image_cache);
+		fz_try(ctx)
+			cache->buckets = fz_malloc_struct_array(ctx, 64, pdf_inline_image_content *);
+		fz_catch(ctx)
+		{
+			fz_free(ctx, cache);
+			fz_rethrow(ctx);
+		}
+		cache->size = 64;
+		cache->bytes = sizeof *cache + 64 * sizeof *cache->buckets;
+		doc->inline_images = cache;
+	}
+	content = find_inline_image_content(cache, key, key_len, hash);
+	if (!content)
+	{
+		size_t need = sizeof *content + key_len * sizeof *key;
+		if (cache->count >= cache->size * 2)
+			need += (size_t)cache->size * 3 * sizeof *cache->buckets;
+		if (cache->bytes + need > INLINE_IMAGE_MAX_BYTES)
+			return;
+		if (cache->count >= cache->size * 2)
+		{
+			int i, size = cache->size * 4;
+			pdf_inline_image_content **buckets = fz_malloc_struct_array(ctx, size, pdf_inline_image_content *);
+			for (i = 0; i < cache->size; i++)
+			{
+				pdf_inline_image_content *c = cache->buckets[i];
+				while (c)
+				{
+					pdf_inline_image_content *next = c->next;
+					c->next = buckets[c->hash % size];
+					buckets[c->hash % size] = c;
+					c = next;
+				}
+			}
+			fz_free(ctx, cache->buckets);
+			cache->buckets = buckets;
+			cache->bytes += (size_t)(size - cache->size) * sizeof *cache->buckets;
+			cache->size = size;
+		}
+		content = fz_malloc_struct(ctx, pdf_inline_image_content);
+		fz_try(ctx)
+		{
+			content->key = fz_malloc_array(ctx, key_len, int);
+			memcpy(content->key, key, key_len * sizeof *key);
+		}
+		fz_catch(ctx)
+		{
+			fz_free(ctx, content);
+			fz_rethrow(ctx);
+		}
+		content->key_len = key_len;
+		content->hash = hash;
+		content->next = cache->buckets[hash % cache->size];
+		cache->buckets[hash % cache->size] = content;
+		cache->count++;
+		cache->bytes += sizeof *content + key_len * sizeof *key;
+	}
+	at = find_inline_image_entry(content, (uint32_t)offset);
+	if (at < content->len && content->entries[at].offset == (uint32_t)offset)
+		return;
+	if (content->len == content->cap)
+	{
+		size_t room = (INLINE_IMAGE_MAX_BYTES - cache->bytes) / sizeof *content->entries;
+		int cap = content->cap ? content->cap * 2 : 16;
+		if ((size_t)(cap - content->cap) > room)
+			cap = content->cap + (int)room;
+		if (cap <= content->cap)
+			return;
+		content->entries = fz_realloc_array(ctx, content->entries, cap, pdf_inline_image_entry);
+		cache->bytes += (size_t)(cap - content->cap) * sizeof *content->entries;
+		content->cap = cap;
+	}
+	memmove(&content->entries[at + 1], &content->entries[at], (content->len - at) * sizeof *content->entries);
+	content->entries[at].offset = (uint32_t)offset;
+	content->entries[at].length = (uint32_t)length;
+	content->len++;
+}
+
 void
 pdf_load_compressed_inline_image(fz_context *ctx, pdf_document *doc, pdf_obj *dict, size_t length, fz_stream *file_stm, int indexed, fz_compressed_image *image)
+{
+	pdf_load_compressed_inline_image_from(ctx, doc, dict, length, file_stm, indexed, image, NULL);
+}
+
+void
+pdf_load_compressed_inline_image_from(fz_context *ctx, pdf_document *doc, pdf_obj *dict, size_t length, fz_stream *file_stm, int indexed, fz_compressed_image *image, pdf_obj *content)
 {
 	fz_stream *istm = NULL, *leech = NULL, *decomp = NULL;
 	fz_pixmap *pixmap = NULL;
 	fz_compressed_buffer *bc;
 	int dummy_l2factor = 0;
+	int64_t start = fz_tell(ctx, file_stm);
+	size_t known = 0;
+	int exact;
 
 	fz_var(istm);
 	fz_var(leech);
@@ -442,11 +692,26 @@ pdf_load_compressed_inline_image(fz_context *ctx, pdf_document *doc, pdf_obj *di
 	bc = fz_new_compressed_buffer(ctx);
 	fz_try(ctx)
 	{
-		bc->buffer = fz_new_buffer(ctx, 1024);
 		istm = pdf_open_inline_stream(ctx, doc, dict, length, file_stm, &bc->params);
-		leech = fz_open_leecher(ctx, istm, bc->buffer);
-		decomp = fz_open_image_decomp_stream(ctx, leech, &bc->params, &dummy_l2factor);
-		pixmap = fz_decomp_image_from_stream(ctx, decomp, image, NULL, indexed, 0, NULL);
+		exact = istm == file_stm || !pdf_dict_geta(ctx, dict, PDF_NAME(Filter), PDF_NAME(F));
+		if (exact)
+			known = pdf_find_inline_image_length(ctx, doc, content, start);
+		if (known)
+		{
+			bc->buffer = fz_new_buffer(ctx, known);
+			bc->buffer->len = fz_read(ctx, istm, bc->buffer->data, known);
+			if (bc->buffer->len != known)
+				fz_throw(ctx, FZ_ERROR_FORMAT, "inline image data changed");
+		}
+		else
+		{
+			bc->buffer = fz_new_buffer(ctx, 1024);
+			leech = fz_open_leecher(ctx, istm, bc->buffer);
+			decomp = fz_open_image_decomp_stream(ctx, leech, &bc->params, &dummy_l2factor);
+			pixmap = fz_decomp_image_from_stream(ctx, decomp, image, NULL, indexed, 0, NULL);
+			if (exact)
+				pdf_remember_inline_image_length(ctx, doc, content, start, bc->buffer->len);
+		}
 		fz_set_compressed_image_buffer(ctx, image, bc);
 	}
 	fz_always(ctx)
