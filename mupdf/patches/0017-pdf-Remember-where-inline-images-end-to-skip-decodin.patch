index 6f01a7e..f2ecd2f 100644
--- a/source/pdf/pdf-xref.c
+++ b/source/pdf/pdf-xref.c
@@ -1996,6 +1996,8 @@ pdf_drop_document_imp(fz_context *ctx, fz_document *doc_)
 
 	fz_defer_reap_start(ctx);
 
+	pdf_drop_inline_image_cache(ctx, doc);
