<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="SpUsage, RtlHardcoded">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/page_number"
        style="@style/ReePDF.TextView.Thumb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <FrameLayout
        android:id="@+id/thumb_container"
        android:layout_width="@dimen/dp_112"
        android:layout_height="@dimen/dp_158"
        android:layout_marginTop="@dimen/dp_2"
        app:layout_constraintTop_toBottomOf="@id/page_number"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_rotate_left"
            android:layout_gravity="top|left"
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:background="@null"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_rotate_left_24"
            app:tintMode="src_in"
            app:tint="@color/ic_delete_rotate_position_page_crop_color" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_delete"
            android:layout_gravity="top|right"
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:background="@null"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_close_24"
            app:tintMode="src_in"
            app:tint="@color/ic_delete_rotate_position_page_crop_color" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_select"
            android:layout_gravity="bottom|left"
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_28"
            android:text=""
            android:background="@null"
            android:contentDescription="@null"
            app:buttonTint="@color/ic_checkbox_page_color" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_crop"
            android:layout_gravity="bottom|center"
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_28"
            android:background="@null"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_crop_24"
            app:tintMode="src_in"
            app:tint="@color/ic_delete_rotate_position_page_crop_color" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_position"
            android:layout_gravity="bottom|right"
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_28"
            android:background="@null"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_position_00_24"
            app:tintMode="src_in"
            app:tint="@color/ic_delete_rotate_position_page_crop_color" />
    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_size_label"
        style="@style/ReePDF.TextView.Thumb"
        android:text="@string/tv_size_label_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginBottom="@dimen/dp_10"
        app:layout_constraintTop_toBottomOf="@id/thumb_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
