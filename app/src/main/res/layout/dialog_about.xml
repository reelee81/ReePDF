<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="SpUsage, RtlHardcoded">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/about_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="@dimen/dp_18"
        android:textColor="@color/signature_chooser_title_text_color"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/about_author"
        android:text="@string/about_author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="@dimen/dp_14"
        android:layout_marginTop="@dimen/dp_4"
        app:layout_constraintTop_toBottomOf="@id/about_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/about_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_32"
        android:fillViewport="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toBottomOf="@id/about_author"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/about_bottom_panel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:text="@string/about_readme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/dp_14" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/about_readme_link"
                android:text="@string/about_readme_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:textColor="@color/about_link_color"
                android:textSize="@dimen/dp_14" />

            <com.google.android.material.textview.MaterialTextView
                android:text="@string/about_privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/dp_14" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/about_privacy_link"
                android:text="@string/about_privacy_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:textColor="@color/about_link_color"
                android:textSize="@dimen/dp_14" />

            <com.google.android.material.textview.MaterialTextView
                android:text="@string/about_license"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/dp_14" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/about_license_link"
                android:text="@string/about_license_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:textColor="@color/about_link_color"
                android:textSize="@dimen/dp_14" />

            <com.google.android.material.textview.MaterialTextView
                android:text="@string/about_third_party"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/dp_14" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/about_third_party_link"
                android:text="@string/about_third_party_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:textColor="@color/about_link_color"
                android:textSize="@dimen/dp_14" />

            <com.google.android.material.textview.MaterialTextView
                android:text="@string/about_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/dp_14" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/about_source_link"
                android:text="@string/about_source_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:textColor="@color/about_link_color"
                android:textSize="@dimen/dp_14" />

            <com.google.android.material.textview.MaterialTextView
                android:text="@string/about_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/dp_14" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/about_contact_link"
                android:text="@string/about_contact_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:textColor="@color/about_link_color"
                android:textSize="@dimen/dp_14" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/about_bottom_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_btn_ok"
            style="@style/ReePDF.TextButton"
            android:text="@string/ok_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
